---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.scss';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object | object[];
}

const {
  title,
  description = profile.about,
  image,
  imageAlt = `${profile.name} — ${profile.role}`,
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const fullTitle = title ? `${title} — ${profile.name}` : `${profile.name} — ${profile.role}`;
const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = Astro.url.href;
const ogImage = image ?? new URL(`${base}og.png`, origin).href;
const pageMeta = JSON.stringify({ title: fullTitle, description, url: canonical, image: ogImage, imageAlt, ogType });
const phone = profile.contacts.find((c) => c.label === 'Телефон');
const telegram = profile.contacts.find((c) => c.label === 'Telegram');
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#08090c" />
    <meta name="generator" content={Astro.generator} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <Fragment>
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content={ogType} />
        <meta property="og:locale" content="ru_RU" />
        <meta property="og:site_name" content={profile.name} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={imageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
      </Fragment>
    )}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <title>{fullTitle}</title>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div class="cursor" aria-hidden="true"><span class="cursor-label"></span></div>
    <header class="nav" transition:persist>
      <a class="brand" href={base}>{profile.name}</a>
      <div class="nav-links">
        <nav>
          <a href={`${base}#about`}>Обо мне</a>
          <a href={`${base}#ai`}>AI</a>
          <a href={`${base}#cases`}>Кейсы</a>
          <a href={`${base}#tools`}>Инструменты</a>
          <a href={`${base}#contacts`}>Контакты</a>
        </nav>
        <span class="nav-fade nav-fade--left" aria-hidden="true"></span>
        <span class="nav-fade nav-fade--right" aria-hidden="true"></span>
      </div>
      <div class="nav-contacts">
        {phone && (
          <a class="nav-phone" href={phone.href} aria-label={`Позвонить: ${phone.text}`}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
            <span>{phone.text}</span>
          </a>
        )}
        {telegram && (
          <a class="nav-tg" href={telegram.href} target="_blank" rel="noopener" aria-label={`Telegram ${telegram.text}`}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M21.9 4.3 18.7 19.4c-.24 1.06-.87 1.32-1.76.82l-4.86-3.58-2.35 2.26c-.26.26-.48.48-.98.48l.35-4.96 9.02-8.15c.39-.35-.09-.54-.6-.2L6.37 13.1l-4.8-1.5c-1.04-.33-1.06-1.04.22-1.54L20.55 2.8c.87-.32 1.63.2 1.35 1.5z"/></svg>
          </a>
        )}
      </div>
    </header>
    <main data-page-meta={pageMeta}>
      <slot />
    </main>
    <footer class="footer wrap">
      <span>© {new Date().getFullYear()} {profile.name}</span>
    </footer>
  </body>
</html>

<script>
  import { initCursor } from '../scripts/cursor';
  import '../scripts/motion';
  import '../scripts/page-transition';

  initCursor();

  // Мобильное меню: градиентные края включаются только там, где ссылки реально обрезаны.
  function initNavFades() {
    const wrap = document.querySelector<HTMLElement>('.nav-links');
    const scroller = wrap?.querySelector<HTMLElement>('nav');
    if (!wrap || !scroller) return;

    const update = () => {
      const max = scroller.scrollWidth - scroller.clientWidth;
      wrap.classList.toggle('can-left', scroller.scrollLeft > 1);
      wrap.classList.toggle('can-right', max > 1 && scroller.scrollLeft < max - 1);
    };

    scroller.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    if (document.fonts) document.fonts.ready.then(update).catch(() => {});
    update();
    requestAnimationFrame(update);
  }

  initNavFades();

  // :active на touch срабатывает не везде, поэтому на время касания ставим класс.
  function initTouchFeedback() {
    let pressed: HTMLElement | null = null;
    let startX = 0;
    let startY = 0;

    const clear = () => {
      pressed?.classList.remove('is-pressed');
      pressed = null;
    };

    document.addEventListener(
      'pointerdown',
      (event) => {
        if (event.pointerType !== 'touch') return;
        const el = (event.target as Element | null)?.closest<HTMLElement>('a, button, [role="button"]');
        if (!el) return;
        clear();
        pressed = el;
        startX = event.clientX;
        startY = event.clientY;
        el.classList.add('is-pressed');
      },
      { passive: true },
    );

    document.addEventListener(
      'pointermove',
      (event) => {
        if (!pressed || event.pointerType !== 'touch') return;
        if (Math.hypot(event.clientX - startX, event.clientY - startY) > 10) clear();
      },
      { passive: true },
    );

    document.addEventListener('pointerup', clear, { passive: true });
    document.addEventListener('pointercancel', clear, { passive: true });
    window.addEventListener('blur', clear);
  }

  initTouchFeedback();

  // ClientRouter меняет только <title>, остальные meta остаются от первой страницы.
  // Синхронизируем canonical/OG/Twitter с данными той страницы, куда перешли.
  function syncPageMeta() {
    const raw = document.querySelector<HTMLElement>('[data-page-meta]')?.dataset.pageMeta;
    if (!raw) return;

    let meta: { title: string; description: string; url: string; image: string; imageAlt: string; ogType: string };
    try {
      meta = JSON.parse(raw);
    } catch {
      return;
    }

    const setContent = (selector: string, value: string) => {
      document.querySelector(selector)?.setAttribute('content', value);
    };

    document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.setAttribute('href', meta.url);
    setContent('meta[name="description"]', meta.description);
    setContent('meta[property="og:type"]', meta.ogType);
    setContent('meta[property="og:title"]', meta.title);
    setContent('meta[property="og:description"]', meta.description);
    setContent('meta[property="og:url"]', meta.url);
    setContent('meta[property="og:image"]', meta.image);
    setContent('meta[property="og:image:alt"]', meta.imageAlt);
    setContent('meta[name="twitter:title"]', meta.title);
    setContent('meta[name="twitter:description"]', meta.description);
    setContent('meta[name="twitter:image"]', meta.image);
  }

  document.addEventListener('astro:after-swap', syncPageMeta);
</script>
