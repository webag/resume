---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Split from '../../components/Split.astro';
import Icon from '../../components/Icon.astro';
import { profile, caseTypes } from '../../data/profile';

export async function getStaticPaths() {
  const cases = (await getCollection('cases', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return cases.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: cases[(i + 1) % cases.length] },
  }));
}

const { entry, next } = Astro.props;
const { title, summary, type, cover, tags, url, source, repo, company, role, year } = entry.data;
const { Content } = await render(entry);
const meta = [caseTypes[type], company, role, year].filter(Boolean);
const base = import.meta.env.BASE_URL;
const origin = Astro.site ?? new URL(Astro.url.origin);
const homeUrl = new URL(base, origin).href;

const og = await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 82 });
const ogImage = new URL(og.src, origin).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: title,
    description: summary,
    image: ogImage,
    url: Astro.url.href,
    inLanguage: 'ru',
    creator: { '@type': 'Person', name: profile.name, url: homeUrl },
    ...(year ? { dateCreated: String(year) } : {}),
    ...(company ? { sourceOrganization: { '@type': 'Organization', name: company } } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: homeUrl },
      { '@type': 'ListItem', position: 2, name: title, item: Astro.url.href },
    ],
  },
];
---

<Base title={title} description={summary} image={ogImage} imageAlt={title} ogType="article" jsonLd={jsonLd}>
  <article class="case wrap">
    <header class="case-head">
      <p class="eyebrow" data-reveal>{meta.join(' · ')}</p>
      <div>
        <Split as="h1" text={title} />
      </div>
      <p class="lead" data-reveal>{summary}</p>
      <div class="case-links" data-reveal>
        {url && <a class="button" href={url} target="_blank" rel="noopener">Открыть сайт <Icon name="arrow-up-right" /></a>}
        {repo && <a class="button ghost" href={repo} target="_blank" rel="noopener">Код <Icon name="arrow-up-right" /></a>}
        {source && <a class="button ghost" href={source} target="_blank" rel="noopener">Кейс агентства <Icon name="arrow-up-right" /></a>}
      </div>
    </header>
    <div class="case-cover">
      <Image src={cover} alt={title} widths={[900, 1600, 2400]} sizes="(max-width: 2560px) 100vw, 2400px" loading="eager" />
    </div>
    <div class="case-body">
      {tags.length > 0 && <ul class="tags" data-reveal>{tags.map((t) => <li>{t}</li>)}</ul>}
      <div class="prose" data-reveal>
        <Content />
      </div>
    </div>
    <a class="next-case" href={`${base}cases/${next.id}/`} data-reveal data-circle={next.data.title} data-astro-prefetch>
      <span class="eyebrow">Следующий кейс</span>
      <span class="next-title">{next.data.title} <Icon name="arrow-right" class="next-icon" /></span>
    </a>
  </article>
  <a class="close-case" href={`${base}#cases`} data-back aria-label="Все кейсы" title="Все кейсы">
    <Icon name="close" />
  </a>
</Base>
